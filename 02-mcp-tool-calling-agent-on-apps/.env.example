# Copy to .env and fill in. DO NOT COMMIT a real .env (it is .gitignored).
# These are PLACEHOLDERS ONLY — no real secrets belong in this file.
#
# On a DEPLOYED Databricks App you set these via app.yaml `env:` (and the
# workspace host + service-principal credentials are injected automatically).
# For LOCAL development, this .env drives both the agent and setup/define_tools.py.

# --- Workspace + auth (local development only) ------------------------------
# Your Databricks workspace URL. Injected automatically on a deployed App.
DATABRICKS_HOST=https://<workspace-hostname>
# Local auth: either a CLI profile OR a token. The deployed App uses its injected
# service principal, so you do NOT set these in app.yaml.
# DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_TOKEN=<your-oauth-access-token-or-pat-for-local-use>

# --- Model ------------------------------------------------------------------
# Any Databricks foundation-model / serving endpoint that supports tool calling.
LLM_ENDPOINT_NAME=databricks-claude-sonnet-5-5

# --- Managed MCP: UC functions + Vector Search ------------------------------
# The catalog/schema where setup/define_tools.py created the function + index.
# Builds:  {host}/api/2.0/mcp/functions/{catalog}/{schema}
#          {host}/api/2.0/mcp/vector-search/{catalog}/{schema}
UC_CATALOG=<your_catalog>
UC_SCHEMA=<your_schema>

# --- Managed MCP: Genie (optional) ------------------------------------------
# The id of a Genie space in your workspace. Builds:
#          {host}/api/2.0/mcp/genie/{genie_space_id}
GENIE_SPACE_ID=<your_genie_space_id>

# --- Custom MCP server (your deployed Databricks App) -----------------------
# Full URL INCLUDING the trailing-slash /mcp/ path.
# Pattern: https://mcp-<name>-<id>.<region>.databricksapps.com/mcp/
CUSTOM_MCP_SERVER_URL=https://mcp-example-operations-0000000000000000.0.azure.databricksapps.com/mcp/

# --- Optional: override the agent's system prompt ---------------------------
# SYSTEM_PROMPT=You are a helpful operations assistant ...
