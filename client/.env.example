# Copy to .env and fill in. DO NOT COMMIT a real .env (it is .gitignored).
# These are PLACEHOLDERS ONLY — no real secrets belong in this file.

# Your Azure Databricks workspace host (used for the OAuth token endpoint and
# for ChatDatabricks foundation-model calls).
DATABRICKS_HOST=https://<workspace-hostname>

# OAuth M2M (client-credentials) identity = the EXTERNAL CALLER's OWN service
# principal (a separate SP you create for this client, or a user) — NOT the
# app's injected service principal. This external SP must be GRANTED access to
# the Databricks App (Apps permissions). The app's own injected SP is the app's
# server-side identity, not the caller's credential.
# Create the SP + an OAuth secret in the workspace (see README "Auth setup").
DATABRICKS_CLIENT_ID=your-external-service-principal-application-id
DATABRICKS_CLIENT_SECRET=your-external-service-principal-oauth-secret

# The deployed Databricks App URL (MCP endpoint is <APP_URL>/mcp/).
# Pattern: https://<app-name>-<id>.<region>.databricksapps.com
APP_URL=https://<app-name>-0000000000000000.0.azure.databricksapps.com

# --- Optional: direct-bearer path (USE_PAT) — see README "PAT quick-test" ---
# USE_PAT=1 sends DATABRICKS_TOKEN as the bearer DIRECTLY (no OAuth exchange).
#   - LOCAL / in-process server: a legacy PAT works (no front door; bearer not verified).
#   - DEPLOYED Databricks App: a legacy PAT is REJECTED by the Apps front door (401 on
#     /mcp/). Use an OAuth token instead — e.g. `databricks auth token -p <profile>`
#     -> access_token (still with USE_PAT=1), or use the M2M client_id/secret path above.
# USE_PAT=1
# DATABRICKS_TOKEN=your-token   # PAT for local only; OAuth access_token for a deployed app
